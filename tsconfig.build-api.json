{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-server",
    "rootDir": ".",
    "module": "ES2022",
    "moduleResolution": "node",
    "target": "ES2022",
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "jsx": "preserve",
    "types": ["node"],
    "lib": ["ES2022"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["dev-server", "msw/db.ts", "msw/jwt.ts", "src/features/rbac/types.ts"],
  "exclude": ["src", "tests", "**/*.test.ts", "**/*.test.tsx"]
}
