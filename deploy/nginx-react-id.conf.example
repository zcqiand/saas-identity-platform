# react-id.xiangru.uk VPS nginx 反代
# 80 → 301 to 443
# 443 → SPA (8061 container 80) + /api/* → saas 真后端（需部署）
#
# 部署清单：
#   1. react-id 容器 8061:80 (nginx SPA, serve dist)
#   2. saas 真后端 Hono（或同等）进程跑独立端口（建议 5176），
#      实际处理 /api/auth/login + /sso/authorize + /auth/oauth/callback
#      + /auth/permissions + /menus
#   3. react-id 容器内 nginx（或 VPS 这层）配 location /api/ → saas 真后端

server {
    listen 80;
    server_name react-id.xiangru.uk;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name react-id.xiangru.uk;

    ssl_certificate     /etc/nginx/ssl/xiangru-uk.cert;
    ssl_certificate_key /etc/nginx/ssl/xiangru-uk.key;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # ==== CORS 给上游 Hono 处理 ====
    # 因为 nginx `if` 块不允许 add_header（CORS 头通常这么写）——
    # 把 OPTIONS 预检交给容器内 Hono cors() 中间件（dev-server/server.ts），
    # 它对 OPTIONS 自动回 204 + Allow-Origin/Headers/Methods/Credentials。
    # 删掉所有 if + add_header，只保留 Vary 让 CDN 按 origin 缓存。
    add_header Vary "Origin" always;

    # ==== SPA 静态资源（react-id 容器 80 端口）====
    location / {
        proxy_pass http://127.0.0.1:8061;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==== /api/* 反代到 saas 真后端 ====
    # 容器只 expose 127.0.0.1:8061:80；5176 在容器内部（supervisord 启），
    # 由容器内 nginx 反代。所以这里 proxy_pass 到 8061，让容器内 nginx 处理。
    location /api/ {
        proxy_pass http://127.0.0.1:8061;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        # OPTIONS 预检：Hono cors() 中间件在容器内自动回 204 + 正确头
    }
}
